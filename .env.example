# Local development: copy to .env. `pnpm db:up` starts Postgres and the mock OIDC provider.
# In production, compose.yaml fills DATABASE_URL, AUTH_SECRET and PUBLIC_URL from Coolify's
# generated SERVICE_* values.

# Database
# Postgres connection string
DATABASE_URL="postgres://root:pebble@localhost:5432/local"
# Where audio files are stored. The Docker image uses /data
DATA_DIR="./data"

# Sign-in (OIDC)
# Issuer URL, used for discovery. The dev mock: http://localhost:8090/default
OIDC_ISSUER="http://localhost:8090/default"
# Client ID registered at the issuer
OIDC_CLIENT_ID="index-01-router"
# Client secret. Leave empty for a public client with PKCE
OIDC_CLIENT_SECRET=""
# Space separated scopes
OIDC_SCOPES="openid profile email"
# Comma separated emails allowed to sign in. Empty allows any account of the issuer
ALLOWED_EMAILS=""
# Signs cookies and encrypts stored API keys, at least 32 characters: openssl rand -hex 32
AUTH_SECRET=""
# Public origin, used to show the webhook URL, e.g. https://index.example.com
PUBLIC_URL="http://localhost:5173"

# Index 01 webhook
# Signing secret. Overrides the one generated on the Webhook page
INDEX01_WEBHOOK_SECRET=""

# Transcription
# Default key for the openai and openai-audio providers
OPENAI_API_KEY=""
# Default key for the gemini provider
GEMINI_API_KEY=""
# ffmpeg and ffprobe binaries, if not on PATH
FFMPEG_PATH="ffmpeg"
FFPROBE_PATH="ffprobe"

# Time
# IANA zone used for daily note dates until one is saved in the UI
TZ="UTC"

# adapter-node (production only, the Docker image sets these)
# Listen port
PORT=3000
# Largest request body. Index 01 audio is about 250 KB per minute
BODY_SIZE_LIMIT="50M"
# Headers set by the reverse proxy, used to build the request origin and client address
PROTOCOL_HEADER="x-forwarded-proto"
HOST_HEADER="x-forwarded-host"
ADDRESS_HEADER="x-forwarded-for"
# Without a proxy in front, set the origin instead, or every form post fails with 403
# ORIGIN="http://localhost:3000"

# compose.yaml sidecars (production)
# Which optional services to run: obsidian, whisper, or both separated by a comma
COMPOSE_PROFILES=""
# Bearer key of the obsidian-rest container. Paste the same value into the Obsidian integration
OBSIDIAN_API_KEY=""
# whisper.cpp model downloaded on first start: tiny, base, small, medium, large-v3-turbo
WHISPER_MODEL="base"
# CPU threads for whisper.cpp
WHISPER_THREADS=4
